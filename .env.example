# ─── ENVIRONMENT CONFIGURATION ────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit real credentials to git.
# In CI/CD: set these as GitHub Secrets or Jenkins Credentials instead.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment to run against: development | staging | production
NODE_ENV=development

# ── Application URLs ─────────────────────────────────────────────────────────
# Override these per environment in your CI pipeline
SANDBOX_URL=https://sandbox.yourcompany.com
STAGING_URL=https://staging.yourcompany.com
PROD_URL=https://yourcompany.com

# ── EventHub API (Rahul Shetty Academy practice app) ─────────────────────────
API_URL=https://api.eventhub.rahulshettyacademy.com/api
UI_URL=https://eventhub.rahulshettyacademy.com

# ── Ecom practice site ───────────────────────────────────────────────────────
ECOM_API_URL=https://rahulshettyacademy.com/api/ecom
ECOM_UI_URL=https://rahulshettyacademy.com/client

# ── AI Self-Healing (optional — tests still run without this) ─────────────────
# Get your key from: https://console.anthropic.com/
# In GitHub Actions: Settings → Secrets → Actions → New secret: ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Test credentials (practice sites only — safe to store here) ──────────────
GMAIL_USER=luxortest1@gmail.com
GMAIL_PASS=Oneplus@0908
YAHOO_USER=luxor@yahoo.com
YAHOO_PASS=Oneplus@0908
SAUCE_USER=standard_user
SAUCE_PASS=secret_sauce
